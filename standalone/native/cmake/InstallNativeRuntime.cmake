    CONFLICTING_DEPENDENCIES_PREFIX conflict
    DIRECTORIES ${existing_dirs}
    PRE_EXCLUDE_REGEXES ${pre_excludes} POST_EXCLUDE_REGEXES ${post_excludes})
  if(unresolved OR conflict_FILENAMES)
    message(FATAL_ERROR "Native runtime closure is incomplete or ambiguous for '${binary}'; unresolved='${unresolved}', conflicting='${conflict_FILENAMES}'. Supply CHROMELLM_NATIVE_RUNTIME_DIRS for the matching runtime.")
  endif()
