cmake_minimum_required(VERSION 3.20)
foreach(required CHROMELLM_PACKAGE_STAGE CHROMELLM_PRODUCT_SOURCE CHROMELLM_LLAMA_SOURCE)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required} for native notices")
  endif()
endforeach()
set(destination "${CHROMELLM_PACKAGE_STAGE}/META-INF/licenses")
set(staging "${destination}.staging")
file(REMOVE_RECURSE "${staging}")
file(MAKE_DIRECTORY "${staging}")

function(chromellm_copy_notice source relative name)
  if(NOT EXISTS "${source}/${relative}" OR IS_DIRECTORY "${source}/${relative}")
    message(FATAL_ERROR "Missing native dependency notice: ${source}/${relative}")
  endif()
  get_filename_component(parent "${staging}/${name}/${relative}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  configure_file("${source}/${relative}" "${staging}/${name}/${relative}" COPYONLY)
endfunction()

function(chromellm_notice_files source result)
  if(NOT IS_DIRECTORY "${source}")
    message(FATAL_ERROR "Missing dependency notice directory: ${source}")
  endif()
  file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${source}" "${source}/*")
  get_filename_component(directory_name "${source}" NAME)
  string(TOLOWER "${directory_name}" directory_name)
  set(notices)
  foreach(relative IN LISTS files)
    get_filename_component(basename "${relative}" NAME)
    string(TOLOWER "${basename}" lower)
    # Preserve license texts and attribution metadata, never source bodies.
    if(lower MATCHES "^(license|licence|copying|copyright|notice|authors)([._-].*)?$"
        OR lower STREQUAL "readme.chromium"
        OR directory_name STREQUAL "licenses" OR directory_name STREQUAL "licences"
        OR relative MATCHES "(^|/)[Ll][Ii][Cc][Ee][Nn][Ss][Ee][Ss]/[^/]+$")
      if(NOT lower MATCHES "\\.(c|cc|cpp|cxx|h|hh|hpp|java|py|js|ts|sh|bat|exe|dll|so|a|lib)$"
          AND NOT relative MATCHES "(^|/)\\.git/")
        list(APPEND notices "${relative}")
      endif()
    endif()
  endforeach()
  list(SORT notices)
  set(${result} "${notices}" PARENT_SCOPE)
endfunction()

function(chromellm_copy_notices source name)
  chromellm_copy_notice("${source}" LICENSE "${name}")
  foreach(extra NOTICE THIRD_PARTY.md AUTHORS COPYRIGHT)
    if(EXISTS "${source}/${extra}")
      chromellm_copy_notice("${source}" "${extra}" "${name}")
    endif()
  endforeach()
  if(IS_DIRECTORY "${source}/licenses")
    chromellm_notice_files("${source}/licenses" notices)
    foreach(relative IN LISTS notices)
      chromellm_copy_notice("${source}" "licenses/${relative}" "${name}")
    endforeach()
  endif()
endfunction()

chromellm_copy_notices("${CHROMELLM_PRODUCT_SOURCE}" chromellm)
chromellm_copy_notices("${CHROMELLM_LLAMA_SOURCE}" llama)
# The pinned CPU sources also contain notices that are not repeated in llama's
# root LICENSE or licenses directory. Preserve only these exact comment blocks.
set(sgemm_source "ggml/src/ggml-cpu/llamafile/sgemm.cpp")
set(ops_source "ggml/src/ggml-cpu/ops.cpp")
if(NOT EXISTS "${CHROMELLM_LLAMA_SOURCE}/${sgemm_source}"
    OR NOT EXISTS "${CHROMELLM_LLAMA_SOURCE}/${ops_source}")
  message(FATAL_ERROR "Missing expected CPU source notices; review the selected llama.cpp revision before distribution")
endif()
file(READ "${CHROMELLM_LLAMA_SOURCE}/${sgemm_source}" sgemm_prefix LIMIT 16384)
string(REGEX MATCH "^(//[^\n]*\n)+" sgemm_notice "${sgemm_prefix}")
if(NOT sgemm_notice MATCHES "Copyright 2024 Mozilla Foundation"
    OR NOT sgemm_notice MATCHES "Permission is hereby granted"
    OR NOT sgemm_notice MATCHES "SOFTWARE[.]")
  message(FATAL_ERROR "The expected Mozilla CPU-kernel license block changed; review the source notice")
endif()
file(STRINGS "${CHROMELLM_LLAMA_SOURCE}/${ops_source}" ops_notices
  REGEX "^[ \t]*// MIT licensed[.] Copyright \\(c\\) 2023 Jeffrey Quesnelle and Bowen Peng[.]$")
list(LENGTH ops_notices ops_notice_count)
if(NOT ops_notice_count EQUAL 1)
  message(FATAL_ERROR "The expected CPU operations copyright notice changed; review the source notice")
endif()
file(WRITE "${staging}/llama/INLINE_NOTICES.txt"
  "Source: ${sgemm_source}\n${sgemm_notice}\nSource: ${ops_source}\n${ops_notices}\n\nThe MIT license text is also retained in LICENSE.\n")
if(CHROMELLM_DAWN_SOURCE)
  chromellm_copy_notices("${CHROMELLM_DAWN_SOURCE}" dawn)
  # Dawn does not supply a root LICENSE.chromium aggregate. Collect the exact
  # texts from populated dependencies, preserving their attribution paths.
  chromellm_notice_files("${CHROMELLM_DAWN_SOURCE}/third_party" notices)
  set(license_count 0)
  set(abseil_license FALSE)
  set(spirv_headers_license FALSE)
  foreach(relative IN LISTS notices)
    chromellm_copy_notice("${CHROMELLM_DAWN_SOURCE}" "third_party/${relative}" dawn)
    get_filename_component(basename "${relative}" NAME)
    string(TOLOWER "${basename}" lower)
    if(lower MATCHES "^(license|licence|copying)([._-].*)?$")
      math(EXPR license_count "${license_count} + 1")
      if(relative MATCHES "^abseil-cpp/")
        set(abseil_license TRUE)
      elseif(relative MATCHES "^spirv-headers/")
        set(spirv_headers_license TRUE)
      endif()
    endif()
  endforeach()
  if(license_count EQUAL 0 OR NOT abseil_license OR NOT spirv_headers_license)
    message(FATAL_ERROR "Dawn packaging requires populated third-party license texts, including Abseil and SPIRV-Headers")
  endif()
elseif(CHROMELLM_DAWN_PREFIX OR CHROMELLM_DAWN_LICENSE_DIR)
  set(bundle "${CHROMELLM_DAWN_LICENSE_DIR}")
  if(NOT bundle)
    set(bundle "${CHROMELLM_DAWN_PREFIX}/share/licenses")
  endif()
  chromellm_notice_files("${bundle}" notices)
  set(license_count 0)
  foreach(relative IN LISTS notices)
    chromellm_copy_notice("${bundle}" "${relative}" dawn)
    get_filename_component(basename "${relative}" NAME)
    string(TOLOWER "${basename}" lower)
    if(lower MATCHES "^(license|licence|copying)([._-].*)?$")
      math(EXPR license_count "${license_count} + 1")
    endif()
  endforeach()
  if(license_count EQUAL 0)
    message(FATAL_ERROR "Installed Dawn requires a populated matching license bundle via CHROMELLM_DAWN_LICENSE_DIR or <prefix>/share/licenses")
  endif()
endif()

# Describe the actual collected texts without inferring license qualification.
file(GLOB_RECURSE installed LIST_DIRECTORIES FALSE RELATIVE "${staging}" "${staging}/*")
list(SORT installed)
set(inventory "path\tsha256\n")
foreach(relative IN LISTS installed)
  file(SHA256 "${staging}/${relative}" digest)
  string(APPEND inventory "${relative}\t${digest}\n")
endforeach()
file(WRITE "${staging}/NOTICE_FILES.tsv" "${inventory}")
file(REMOVE_RECURSE "${destination}")
file(RENAME "${staging}" "${destination}")
