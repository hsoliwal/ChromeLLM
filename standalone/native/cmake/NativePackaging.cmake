# SPDX-License-Identifier: MIT
# Package the selected native runtime as flat, verified class-path resources.
option(CHROMELLM_INSTALL_NATIVE "Install the JNI runtime and its shared-library closure as Maven resources" OFF)
option(CHROMELLM_PACKAGE_TEST_FIXTURE "Permit a clearly marked synthetic test-only native package" OFF)
set(CHROMELLM_NATIVE_CLASSIFIER "" CACHE STRING "Native artifact classifier; checked against the CMake target")
set(CHROMELLM_NATIVE_RUNTIME_DIRS "" CACHE STRING "Additional directories used only to resolve runtime dependencies")

function(chromellm_configure_native_packaging)
  if(NOT CHROMELLM_INSTALL_NATIVE)
    return()
  endif()
  if(CHROMELLM_SYNTHETIC_TEST AND NOT CHROMELLM_PACKAGE_TEST_FIXTURE)
    message(FATAL_ERROR "Synthetic native code cannot be packaged without CHROMELLM_PACKAGE_TEST_FIXTURE=ON")
  endif()
  if(CHROMELLM_PACKAGE_TEST_FIXTURE AND NOT CHROMELLM_SYNTHETIC_TEST)
    message(FATAL_ERROR "CHROMELLM_PACKAGE_TEST_FIXTURE is only valid for the synthetic fixture")
  endif()
  if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "Native Maven packages currently require a 64-bit target")
  endif()

  string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" processor)
  if(CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES arch_count)
    if(NOT arch_count EQUAL 1)
      message(FATAL_ERROR "Build one native Maven architecture at a time, not a universal binary")
    endif()
    string(TOLOWER "${CMAKE_OSX_ARCHITECTURES}" processor)
  elseif(CMAKE_GENERATOR_PLATFORM)
    string(TOLOWER "${CMAKE_GENERATOR_PLATFORM}" processor)
  endif()
  if(processor MATCHES "^(x86_64|amd64|x64)$")
    set(arch x86_64)
  elseif(processor MATCHES "^(aarch64|arm64)$")
    set(arch aarch64)
  else()
    message(FATAL_ERROR "Unsupported native Maven target architecture: ${processor}")
  endif()
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(os linux)
    set(platform linux+elf)
    set(CMAKE_INSTALL_RPATH "$ORIGIN" PARENT_SCOPE)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(os macos)
    set(platform macos+macho)
    set(CMAKE_INSTALL_RPATH "@loader_path" PARENT_SCOPE)
    set(CMAKE_INSTALL_NAME_DIR "@rpath" PARENT_SCOPE)
    set(CMAKE_BUILD_WITH_INSTALL_NAME_DIR TRUE PARENT_SCOPE)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
    set(os windows)
    set(platform windows+pe)
  else()
    message(FATAL_ERROR "Unsupported native Maven target system: ${CMAKE_SYSTEM_NAME}")
  endif()
  if(os STREQUAL "windows" AND NOT arch STREQUAL "x86_64")
    message(FATAL_ERROR "Windows native Maven packages currently support x86_64 only")
  endif()
  set(expected "${os}-${arch}")
  if(CHROMELLM_NATIVE_CLASSIFIER AND NOT CHROMELLM_NATIVE_CLASSIFIER STREQUAL expected)
    message(FATAL_ERROR "Native classifier '${CHROMELLM_NATIVE_CLASSIFIER}' disagrees with CMake target '${expected}'")
  endif()
  set(CHROMELLM_NATIVE_CLASSIFIER "${expected}" CACHE STRING "Native artifact classifier; checked against the CMake target" FORCE)
  set(CHROMELLM_RUNTIME_PLATFORM "${platform}" PARENT_SCOPE)
  set(CHROMELLM_RUNTIME_OS "${os}" PARENT_SCOPE)
  # Mach-O dependency scanning uses LC_RPATH, not DIRECTORIES. Keep build rpaths
  # until the installer rewrites every copied reference and removes LC_RPATH.
  if(os STREQUAL "macos")
    set(CMAKE_BUILD_WITH_INSTALL_RPATH FALSE PARENT_SCOPE)
  else()
    set(CMAKE_BUILD_WITH_INSTALL_RPATH TRUE PARENT_SCOPE)
  endif()
  set(CMAKE_INSTALL_RPATH_USE_LINK_PATH FALSE PARENT_SCOPE)
endfunction()

function(chromellm_shared_target_dirs directory result)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  set(directories)
  foreach(target IN LISTS targets)
    get_target_property(type "${target}" TYPE)
    if(type STREQUAL "SHARED_LIBRARY" OR type STREQUAL "MODULE_LIBRARY")
      list(APPEND directories "$<TARGET_FILE_DIR:${target}>")
    endif()
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    chromellm_shared_target_dirs("${child}" child_dirs)
    list(APPEND directories ${child_dirs})
  endforeach()
  set(${result} "${directories}" PARENT_SCOPE)
endfunction()

function(chromellm_install_native_runtime target)
  if(NOT CHROMELLM_INSTALL_NATIVE)
    return()
  endif()
  if(CHROMELLM_RUNTIME_OS STREQUAL "linux")
    # DT_RPATH is inherited by transitive dependencies. The packaged dependency
    # copies have their original rpaths removed below, so build paths cannot win.
    target_link_options("${target}" PRIVATE "-Wl,--disable-new-dtags")
  elseif(CHROMELLM_RUNTIME_OS STREQUAL "windows")
    # Match System.mapLibraryName even when a MinGW toolchain defaults to 'lib'.
    set_target_properties("${target}" PROPERTIES PREFIX "")
  endif()
  chromellm_shared_target_dirs("${CMAKE_CURRENT_SOURCE_DIR}" runtime_dirs)
  list(APPEND runtime_dirs ${CHROMELLM_NATIVE_RUNTIME_DIRS})
  foreach(variable LLAMA_LIBRARY GGML_LIBRARY GGML_BASE_LIBRARY)
    if(IS_ABSOLUTE "${${variable}}")
      get_filename_component(directory "${${variable}}" DIRECTORY)
      list(APPEND runtime_dirs "${directory}")
    endif()
  endforeach()
  foreach(prefix IN LISTS CMAKE_PREFIX_PATH)
    list(APPEND runtime_dirs "${prefix}/lib" "${prefix}/lib64" "${prefix}/bin")
  endforeach()
  if(Dawn_DIR)
    list(APPEND runtime_dirs "${Dawn_DIR}/../.." "${Dawn_DIR}/../../../bin")
  endif()
  list(REMOVE_DUPLICATES runtime_dirs)
  set(CHROMELLM_PACKAGE_ROOT "$<TARGET_FILE:${target}>")
  set(CHROMELLM_PACKAGE_ROOT_NAME "$<TARGET_FILE_NAME:${target}>")
  set(CHROMELLM_PACKAGE_RUNTIME_DIRS "${runtime_dirs}")
  if(CHROMELLM_RUNTIME_OS STREQUAL "windows" AND MSVC)
    get_filename_component(linker_dir "${CMAKE_LINKER}" DIRECTORY)
    find_program(CHROMELLM_RUNTIME_COMMAND NAMES dumpbin HINTS "${linker_dir}" REQUIRED)
    set(CHROMELLM_RUNTIME_TOOL dumpbin)
  elseif(CHROMELLM_RUNTIME_OS STREQUAL "macos")
    find_program(CHROMELLM_RUNTIME_COMMAND NAMES otool REQUIRED)
    set(CHROMELLM_RUNTIME_TOOL otool)
  else()
    if(CMAKE_OBJDUMP)
      set(CHROMELLM_RUNTIME_COMMAND "${CMAKE_OBJDUMP}")
    else()
      find_program(CHROMELLM_RUNTIME_COMMAND NAMES objdump REQUIRED)
    endif()
    set(CHROMELLM_RUNTIME_TOOL objdump)
  endif()
  if(CHROMELLM_SYNTHETIC_TEST)
    set(CHROMELLM_PACKAGE_SYNTHETIC true)
  else()
    set(CHROMELLM_PACKAGE_SYNTHETIC false)
  endif()
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/InstallNativeRuntime.cmake"
    "${CMAKE_CURRENT_BINARY_DIR}/InstallNativeRuntime.in.cmake" @ONLY)
  file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/InstallNativeRuntime-$<CONFIG>.cmake"
    INPUT "${CMAKE_CURRENT_BINARY_DIR}/InstallNativeRuntime.in.cmake")
  install(SCRIPT "${CMAKE_CURRENT_BINARY_DIR}/InstallNativeRuntime-$<CONFIG>.cmake"
    COMPONENT ChromeLLMNative)
endfunction()
