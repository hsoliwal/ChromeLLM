            <id>require-dawn-compatible-build</id><phase>validate</phase><goals><goal>enforce</goal></goals>
            <configuration><rules>
              <requireProperty>
                <property>chromellm.dawn.owner</property><regex>^native-dawn$</regex>
                <message>native-dawn and dawn-binary cannot be combined; select one Dawn provisioning profile</message>
                <regexMessage>native-dawn and dawn-binary cannot be combined; select one Dawn provisioning profile</regexMessage>
              </requireProperty>
              <requireProperty>
                <property>chromellm.native.mode</property><regex>^(none|fork)$</regex>
                <message>native-dawn cannot be used with native-synthetic or fork-native; use dawn-binary with fork-native</message>
                <regexMessage>native-dawn cannot be used with native-synthetic or fork-native; use dawn-binary with fork-native</regexMessage>
              </requireProperty>
              <requireProperty>
                <property>chromellm.native.webgpu</property><regex>^ON$</regex>
