    <profile>
      <id>chrome-status</id>
      <properties><chromellm.chrome.mode>status</chromellm.chrome.mode></properties>
      <build><plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version>
          <executions><execution>
            <id>require-exclusive-chrome-status</id><phase>validate</phase><goals><goal>enforce</goal></goals>
            <configuration><rules><requireProperty>
              <property>chromellm.chrome.mode</property><regex>^status$</regex>
              <message>Choose exactly one of chrome-status, chrome-prepare or chrome-infer</message>
              <regexMessage>Choose exactly one of chrome-status, chrome-prepare or chrome-infer</regexMessage>
            </requireProperty></rules></configuration>
          </execution></executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
