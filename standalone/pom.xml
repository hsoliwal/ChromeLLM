<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.synexia.chromellm</groupId>
  <artifactId>chromellm-standalone</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <!-- No third-party Java dependencies, including at runtime. -->
  <build><plugins>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version>
      <configuration><release>21</release></configuration>
    </plugin>
    <plugin>
      <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
      <executions><execution>
        <id>standalone-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.StandaloneContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution></executions>
    </plugin>
  </plugins></build>
</project>
