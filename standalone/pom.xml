      <properties>
        <chromellm.dawn.owner>native-dawn</chromellm.dawn.owner>
        <chromellm.native.webgpu>ON</chromellm.native.webgpu>
        <chromellm.native.dawn.prefix>${project.build.directory}/native-deps/dawn</chromellm.native.dawn.prefix>
      </properties>
      <build><plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version>
