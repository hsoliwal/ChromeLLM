<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.synexia.chromellm</groupId>
  <artifactId>chromellm-standalone</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <chromellm.native.mode>none</chromellm.native.mode>
    <chromellm.native.dawn.prefix>NONE</chromellm.native.dawn.prefix>
    <chromellm.chrome.profile>${user.home}/.chromellm/chrome-ai-profile</chromellm.chrome.profile>
    <chromellm.chrome.headless>true</chromellm.chrome.headless>
    <chromellm.chrome.allowDownload>false</chromellm.chrome.allowDownload>
    <chromellm.chrome.timeoutSeconds>120</chromellm.chrome.timeoutSeconds>
    <chromellm.chrome.maxTokens>512</chromellm.chrome.maxTokens>
    <chromellm.dawn.owner>none</chromellm.dawn.owner>
    <!-- Opt-in source fork and inference recipes; no native/model work in the default build. -->
    <chromellm.fork.source></chromellm.fork.source>
    <chromellm.fork.commit></chromellm.fork.commit>
    <chromellm.fork.webgpu>OFF</chromellm.fork.webgpu>
    <chromellm.fork.prefix></chromellm.fork.prefix>
    <chromellm.fork.configuration>Release</chromellm.fork.configuration>
    <chromellm.smart.recipe></chromellm.smart.recipe>
    <chromellm.cmake.executable>cmake</chromellm.cmake.executable>
    <chromellm.ctest.executable>ctest</chromellm.ctest.executable>
    <chromellm.fork.dawnDir></chromellm.fork.dawnDir>
    <chromellm.artifact.cache>${user.home}/.cache/chromellm</chromellm.artifact.cache>
    <chromellm.smoke.library>${project.build.directory}/fork-native/chromellm-native-${chromellm.fork.configuration}.txt</chromellm.smoke.library>
    <chromellm.smoke.compute>cpu</chromellm.smoke.compute>
  </properties>
  <!-- No third-party Java dependencies, including at runtime. -->
  <build><plugins>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version>
      <configuration><release>21</release></configuration>
      <executions><execution>
        <id>default-testCompile</id>
        <configuration><useModulePath>false</useModulePath></configuration>
      </execution></executions>
    </plugin>
    <plugin>
      <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
      <executions><execution>
        <id>standalone-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.StandaloneContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution><execution>
        <id>gemini-api-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.GeminiApiBackendContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution><execution>
        <id>provider-selection-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.ProviderSelectionContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution><execution>
        <id>chrome-process-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.ChromeProcessContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution><execution>
        <id>chrome-devtools-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.ChromeDevToolsContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution><execution>
        <id>chrome-backend-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.ChromeAiBackendContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution><execution>
        <id>chrome-script-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.ChromeAiScriptContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution>
      <execution>
        <id>fork-smart-build-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.SmartBuildContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution><execution>
        <id>native-artifact-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.NativeBuildArtifactsContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution><execution>
        <id>model-artifact-http-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.ModelArtifactHttpContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution>
      <execution>
        <id>agent-session-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.AgentSessionContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution>
      <execution>
        <id>coding-agent-tools-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.CodingAgentToolsContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution>
      <execution>
        <id>agent-entrypoint-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.AgentEntrypointContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution>
      <execution>
        <id>agent-contract-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.chromellm.standalone.AgentContractTestMain</mainClass>
          <classpathScope>test</classpathScope>
        </configuration>
      </execution>
      </executions>
    </plugin>
  </plugins></build>
  <profiles>
    <profile>
      <id>fork-native</id>
      <properties><chromellm.native.mode>pinned-fork</chromellm.native.mode></properties>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version>
        <executions><execution>
          <id>require-pinned-fork-build</id><phase>validate</phase><goals><goal>enforce</goal></goals>
          <configuration><rules><requireProperty>
            <property>chromellm.native.mode</property><regex>^pinned-fork$</regex>
            <message>fork-native cannot be combined with native-fork or native-synthetic</message>
            <regexMessage>fork-native cannot be combined with native-fork or native-synthetic</regexMessage>
          </requireProperty></rules></configuration>
        </execution></executions>
      </plugin><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>verify-fork-source-pin</id><phase>process-classes</phase><goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.synexia.chromellm.standalone.ForkSourcePin</mainClass>
              <arguments>
                <argument>${chromellm.fork.source}</argument>
                <argument>${chromellm.fork.commit}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>configure-fork-jni</id><phase>prepare-package</phase><goals><goal>exec</goal></goals>
            <configuration>
              <executable>${chromellm.cmake.executable}</executable>
              <arguments>
                <argument>-S</argument><argument>${project.basedir}/native</argument>
                <argument>-B</argument><argument>${project.build.directory}/fork-native</argument>
                <argument>-DCHROMELLM_LLAMA_SOURCE_DIR=${chromellm.fork.source}</argument>
                <argument>-DCHROMELLM_WEBGPU=${chromellm.fork.webgpu}</argument>
                <argument>-DCMAKE_PREFIX_PATH=${chromellm.fork.prefix}</argument>
                <argument>-DDawn_DIR=${chromellm.fork.dawnDir}</argument>
                <argument>-DCHROMELLM_DAWN_PREFIX=${chromellm.native.dawn.prefix}</argument>
                <argument>-DCMAKE_BUILD_TYPE=${chromellm.fork.configuration}</argument>
                <argument>-DGGML_NATIVE=OFF</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>build-fork-jni</id><phase>prepare-package</phase><goals><goal>exec</goal></goals>
            <configuration>
              <executable>${chromellm.cmake.executable}</executable>
              <arguments>
                <argument>--build</argument><argument>${project.build.directory}/fork-native</argument>
                <argument>--config</argument><argument>${chromellm.fork.configuration}</argument>
                <argument>--parallel</argument><argument>2</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>smart-build</id>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <executions><execution>
          <id>run-explicit-smart-build-recipe</id><phase>verify</phase><goals><goal>java</goal></goals>
          <configuration>
            <mainClass>io.synexia.chromellm.standalone.SmartBuildMain</mainClass>
            <systemProperties><systemProperty>
              <key>chromellm.offline</key><value>offline=${session.offline}</value>
            </systemProperty></systemProperties>
            <arguments>
              <argument>${chromellm.smart.recipe}</argument>
              <argument>${project.basedir}</argument>
              <argument>${project.build.directory}</argument>
              <argument>--offline=${settings.offline}</argument>
            </arguments>
          </configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>native-synthetic</id>
      <properties><chromellm.native.mode>synthetic</chromellm.native.mode></properties>
      <build><plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version>
          <executions><execution>
            <id>require-synthetic-only</id><phase>validate</phase><goals><goal>enforce</goal></goals>
            <configuration><rules><requireProperty>
              <property>chromellm.native.mode</property><regex>^synthetic$</regex>
              <message>native-synthetic and native-fork cannot be active together</message>
              <regexMessage>native-synthetic and native-fork cannot be active together</regexMessage>
            </requireProperty></rules></configuration>
          </execution></executions>
        </plugin>
        <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
        <executions>
          <execution>
            <id>native-synthetic-configure</id><phase>generate-resources</phase><goals><goal>exec</goal></goals>
            <configuration><executable>${chromellm.cmake.executable}</executable><arguments>
              <argument>-S</argument><argument>${project.basedir}/native</argument>
              <argument>-B</argument><argument>${project.build.directory}/native-synthetic</argument>
              <argument>-DCHROMELLM_SYNTHETIC_TEST=ON</argument>
              <argument>-DCMAKE_BUILD_TYPE=Release</argument>
            </arguments></configuration>
          </execution>
          <execution>
            <id>native-synthetic-build</id><phase>process-resources</phase><goals><goal>exec</goal></goals>
            <configuration><executable>${chromellm.cmake.executable}</executable><arguments>
              <argument>--build</argument><argument>${project.build.directory}/native-synthetic</argument>
              <argument>--config</argument><argument>Release</argument>
              <argument>--parallel</argument><argument>2</argument>
            </arguments></configuration>
          </execution>
          <execution>
            <id>native-synthetic-ctest</id><phase>verify</phase><goals><goal>exec</goal></goals>
            <configuration><executable>${chromellm.ctest.executable}</executable><arguments>
              <argument>--test-dir</argument><argument>${project.build.directory}/native-synthetic</argument>
              <argument>-C</argument><argument>Release</argument>
              <argument>--output-on-failure</argument>
            </arguments></configuration>
          </execution>
        </executions>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>native-fork</id>
      <properties>
        <chromellm.native.webgpu>OFF</chromellm.native.webgpu>
        <chromellm.native.mode>fork</chromellm.native.mode>
      </properties>
      <build><plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version>
          <executions><execution>
            <id>require-explicit-native-fork</id><phase>validate</phase><goals><goal>enforce</goal></goals>
            <configuration><rules><requireProperty>
              <property>chromellm.native.source</property>
              <regex>.*\S.*</regex>
              <message>native-fork requires -Dchromellm.native.source=/absolute/path/to/llama.cpp</message>
              <regexMessage>native-fork requires -Dchromellm.native.source=/absolute/path/to/llama.cpp</regexMessage>
            </requireProperty><requireProperty>
              <property>chromellm.native.mode</property><regex>^fork$</regex>
              <message>native-synthetic and native-fork cannot be active together</message>
              <regexMessage>native-synthetic and native-fork cannot be active together</regexMessage>
            </requireProperty></rules></configuration>
          </execution></executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
          <executions>
            <execution>
              <id>native-fork-configure</id><phase>generate-resources</phase><goals><goal>exec</goal></goals>
              <configuration><executable>${chromellm.cmake.executable}</executable><arguments>
                <argument>-S</argument><argument>${project.basedir}/native</argument>
                <argument>-B</argument><argument>${project.build.directory}/native-fork</argument>
                <argument>-DCHROMELLM_LLAMA_SOURCE_DIR=${chromellm.native.source}</argument>
                <argument>-DCHROMELLM_WEBGPU=${chromellm.native.webgpu}</argument>
                <argument>-DCHROMELLM_DAWN_PREFIX=${chromellm.native.dawn.prefix}</argument>
                <argument>-DCMAKE_BUILD_TYPE=Release</argument>
              </arguments></configuration>
            </execution>
            <execution>
              <id>native-fork-build</id><phase>process-resources</phase><goals><goal>exec</goal></goals>
              <configuration><executable>${chromellm.cmake.executable}</executable><arguments>
                <argument>--build</argument><argument>${project.build.directory}/native-fork</argument>
                <argument>--config</argument><argument>Release</argument>
                <argument>--parallel</argument><argument>2</argument>
              </arguments></configuration>
            </execution>
          </executions>
        </plugin>
      </plugins></build>
    </profile>
    <profile>
      <id>dawn-binary</id>
      <properties>
        <chromellm.dawn.owner>dawn-binary</chromellm.dawn.owner>
        <chromellm.fork.webgpu>ON</chromellm.fork.webgpu>
        <chromellm.fork.prefix>${project.build.directory}/dawn-sdk</chromellm.fork.prefix>
        <chromellm.fork.dawnDir>${project.build.directory}/dawn-sdk/lib64/cmake/Dawn</chromellm.fork.dawnDir>
        <chromellm.smoke.compute>webgpu</chromellm.smoke.compute>
      </properties>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version>
        <executions><execution>
          <id>require-binary-dawn-build</id><phase>validate</phase><goals><goal>enforce</goal></goals>
          <configuration><rules>
            <requireProperty>
              <property>chromellm.native.mode</property><regex>^(none|pinned-fork)$</regex>
              <message>dawn-binary requires fork-native or standalone binary verification</message>
              <regexMessage>dawn-binary requires fork-native or standalone binary verification</regexMessage>
            </requireProperty>
            <requireProperty>
              <property>chromellm.dawn.owner</property><regex>^dawn-binary$</regex>
              <message>native-dawn and dawn-binary cannot be combined; select one Dawn provisioning profile</message>
              <regexMessage>native-dawn and dawn-binary cannot be combined; select one Dawn provisioning profile</regexMessage>
            </requireProperty>
            <requireProperty>
              <property>chromellm.fork.webgpu</property><regex>^ON$</regex>
              <message>dawn-binary requires chromellm.fork.webgpu=ON</message>
              <regexMessage>dawn-binary requires chromellm.fork.webgpu=ON</regexMessage>
            </requireProperty>
          </rules></configuration>
        </execution></executions>
      </plugin><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <executions><execution>
          <id>prepare-dawn-binary</id><phase>process-classes</phase><goals><goal>java</goal></goals>
          <configuration>
            <mainClass>io.synexia.chromellm.standalone.NativeBuildArtifacts</mainClass>
            <arguments>
              <argument>dawn</argument>
              <argument>${chromellm.artifact.cache}</argument>
              <argument>${project.basedir}</argument>
              <argument>${project.build.directory}</argument>
              <argument>offline=${session.offline}</argument>
              <argument>${chromellm.cmake.executable}</argument>
            </arguments>
          </configuration>
        </execution><execution>
          <id>configure-dawn-binary-smoke</id><phase>prepare-package</phase><goals><goal>exec</goal></goals>
          <configuration><executable>${chromellm.cmake.executable}</executable><arguments>
            <argument>-S</argument><argument>${project.basedir}/native/tests/dawn_binary</argument>
            <argument>-B</argument><argument>${project.build.directory}/dawn-smoke</argument>
            <argument>-DDawn_DIR=${chromellm.fork.dawnDir}</argument>
            <argument>-DCMAKE_BUILD_TYPE=Release</argument>
          </arguments></configuration>
        </execution><execution>
          <id>build-dawn-binary-smoke</id><phase>prepare-package</phase><goals><goal>exec</goal></goals>
          <configuration><executable>${chromellm.cmake.executable}</executable><arguments>
            <argument>--build</argument><argument>${project.build.directory}/dawn-smoke</argument>
            <argument>--config</argument><argument>Release</argument>
            <argument>--parallel</argument><argument>2</argument>
          </arguments></configuration>
        </execution><execution>
          <id>run-dawn-binary-smoke</id><phase>verify</phase><goals><goal>exec</goal></goals>
          <configuration><executable>${chromellm.ctest.executable}</executable><arguments>
            <argument>--test-dir</argument><argument>${project.build.directory}/dawn-smoke</argument>
            <argument>-C</argument><argument>Release</argument>
            <argument>--output-on-failure</argument>
          </arguments></configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>real-model</id>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version>
