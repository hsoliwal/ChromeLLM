<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.synexia.intake</groupId><artifactId>repository-hierarchy-intake</artifactId><version>1</version><packaging>pom</packaging>
  <!-- Install the tested canonical recipe crate locally first. No original build is reparented. -->
  <dependencies><dependency><groupId>com.synexia.verification</groupId><artifactId>m3-hierarchy-recipe</artifactId><version>0.1.0-hierarchy1</version></dependency></dependencies>
  <build><plugins><plugin>
    <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.3.0</version>
    <executions><execution><id>file-package-module-project-repository</id><phase>verify</phase><goals><goal>java</goal></goals>
      <configuration><mainClass>com.synexia.ai.m3scale.M3HierarchyMain</mainClass>
        <arguments><argument>${project.basedir}/../..</argument><argument>${m3.output}</argument>
          <argument>${m3.repository}</argument><argument>${m3.revision}</argument><argument>--git</argument></arguments>
      </configuration>
    </execution></executions>
  </plugin></plugins></build>
</project>
